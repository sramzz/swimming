            {zwemwaterMeta?.descriptionNl && (
              <p class="text-sm text-text-muted mb-4 leading-relaxed">
                {zwemwaterMeta.descriptionNl}
              </p>
            )}

            {/* Active Warnings from Zwemwater.nl */}
            {zwemwaterMeta?.warnings && zwemwaterMeta.warnings.length > 0 && (
              <div class="space-y-2.5 mb-5">
                {zwemwaterMeta.warnings.map((w) => (
                  <div class="p-4 rounded-2xl border-2 border-amber-400 bg-amber-50 text-amber-950">
                    <p class="text-xs font-extrabold uppercase tracking-wider text-amber-800 flex items-center gap-1.5">
                      <span>⚠️</span>
                      <span>{w.titleNl}</span>
                    </p>
                    {w.bodyNl && <p class="text-xs mt-1 leading-relaxed">{w.bodyNl}</p>}
                  </div>
                ))}
              </div>
            )}

            {/* Official Metadata Grid */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
              <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle">
                <span class="text-[11px] font-bold text-text-muted uppercase block">Toegang &amp; Terrein</span>
                <p class="text-sm font-extrabold text-text-charcoal mt-0.5">
                  {zwemwaterMeta?.isPaidAccess
                    ? `Betaald terrein (${zwemwaterMeta.entranceFeeCode ?? 'Semi-openbaar'})`
                    : 'Openbaar & Gratis toegankelijk'}
                </p>
              </div>
              <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle">
                <span class="text-[11px] font-bold text-text-muted uppercase block">EU 4-Jaars Waterkwaliteit</span>
                <p class="text-sm font-extrabold text-emerald-800 capitalize mt-0.5">
                  {zwemwaterMeta?.waterQuality4YearClassNl ?? 'Goedgekeurd zwemwater'}
                </p>
              </div>
              {zwemwaterMeta?.locationOwnerNl && (
                <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle">
                  <span class="text-[11px] font-bold text-text-muted uppercase block">Waterbeheerder</span>
                  <p class="text-sm font-bold text-text-charcoal mt-0.5">{zwemwaterMeta.locationOwnerNl}</p>
                </div>
              )}
              {zwemwaterMeta?.recentMeasurementStatusNl && (
                <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle">
                  <span class="text-[11px] font-bold text-text-muted uppercase block">Controle Status</span>
                  <p class="text-sm font-bold text-text-charcoal mt-0.5">
                    {zwemwaterMeta.recentMeasurementStatusNl}
                  </p>
                </div>
              )}
            </div>

            {/* Restrictions & Facilities Pills */}
            {zwemwaterMeta?.featuresNl && zwemwaterMeta.featuresNl.length > 0 && (
              <div class="mb-5">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-text-muted mb-2.5">
                  Voorzieningen, Afbakening &amp; Huisregels op Locatie
                </h3>
                <div class="flex flex-wrap gap-2">
                  {zwemwaterMeta.featuresNl.map((feat) => {
                    const isRestriction =
                      feat.toLowerCase().includes('niet toegestaan') ||
                      feat.toLowerCase().includes('verbod');
                    return (
                      <span
                        class={`px-3 py-1.5 rounded-full text-xs font-bold border ${
                          isRestriction
                            ? 'bg-rose-50 text-rose-800 border-rose-200'
                            : 'bg-surface-pure text-text-charcoal border-border-hairline'
                        }`}
                      >
                        {isRestriction ? `🚫 ${feat}` : `✓ ${feat}`}
                      </span>
                    );
                  })}
                </div>
              </div>
            )}

            {zwemwaterMeta?.seasonTextNl && (
              <p class="text-xs text-text-muted bg-surface-subtle p-3.5 rounded-xl border border-border-hairline mb-5 leading-relaxed">
                {zwemwaterMeta.seasonTextNl}
              </p>
            )}

            {/* Direct Official Documents: Informatiebord & Zwemwaterprofiel */}
            <div class="flex flex-wrap gap-3">
              {zwemwaterMeta?.infoBoardUrl && (
                <a
                  href={zwemwaterMeta.infoBoardUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2.5 rounded-xl bg-primary text-on-primary text-xs font-extrabold hover:bg-primary-container transition-colors shadow-xs"
                >
                  📋 Bekijk Officieel Informatiebord (Rijkswaterstaat) ↗
                </a>
              )}
              {zwemwaterMeta?.waterProfileUrl && (
                <a
                  href={zwemwaterMeta.waterProfileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2.5 rounded-xl border border-border-hairline bg-surface-pure hover:bg-surface-subtle text-text-charcoal text-xs font-extrabold transition-colors"
                >
                  📄 Bekijk Officieel Zwemwaterprofiel ↗
                </a>
              )}
            </div>
          </section>
        )}

        {/* Locatie & Bereikbaarheid (Preserving LazyGoogleMapIframe as requested) */}
        <section id="locatie" class="pt-8">
          <h2 class="text-xl font-extrabold text-text-charcoal mb-2">Locatie &amp; Bereikbaarheid</h2>
          {venue.street_address && (
            <p class="text-sm text-text-muted mb-4">
              {venue.street_address}
              {venue.postcode_pc6 ? `, ${venue.postcode_pc6}` : ''} ({venue.neighborhood_name ?? venue.municipality_slug})
            </p>
          )}
          {transitChips.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
              {transitChips.map((chip) => (
                <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle">
                  <p class="font-bold text-xs text-text-charcoal">{chip.title}</p>
                  <p class="text-xs text-text-muted mt-0.5">{chip.subtitle}</p>
                </div>
              ))}
            </div>
          )}
          <LazyGoogleMapIframe
            venueName={venue.name}
            streetAddress={venue.street_address}
            embedUrl={venue.google_maps_embed_url}
            routeUrl={venue.google_maps_route_url}
          />
        </section>
      </div>

      {/* RIGHT COLUMN: Sticky Booking & Waitlist Calculator Widget (Photo 4) */}
      <aside class="lg:col-span-4 sticky top-28">
        <StickyBookingWidgetIsland
          client:visible
          venueId={venue.id}
          venueName={venue.name}
          adultPriceCents={adultTariff?.price_cents ?? venue.min_single_price_cents ?? 0}
          childPriceCents={childTariff?.price_cents ?? venue.min_single_price_cents ?? 0}
          tenPassPriceCents={tenPassTariff?.price_cents ?? null}
          officialTicketsUrl={venue.official_tickets_url}
          officialWebsiteUrl={venue.official_website_url}
          officialZwemlesUrl={primaryWaitlistOffering?.registration_url ?? venue.official_website_url ?? null}
          googleMapsRouteUrl={venue.google_maps_route_url}
          defaultPc4={venue.postcode_pc4 ?? '1079'}
          ratingScore={venue.rating_score}
          ratingCount={venue.rating_count}
          primaryWaterTreatment={venue.primary_water_treatment}
          isOpenWater={isOpenWater}
          isPaidAccess={zwemwaterMeta?.isPaidAccess ?? false}
          infoBoardUrl={zwemwaterMeta?.infoBoardUrl ?? null}
          waterProfileUrl={zwemwaterMeta?.waterProfileUrl ?? null}
          waterQualityClassNl={zwemwaterMeta?.waterQuality4YearClassNl ?? null}
          seasonTextNl={zwemwaterMeta?.seasonTextNl ?? null}
        />
      </aside>
    </div>
  </main>

  {/* Interactive Photo Lightbox Modal ("Toon alle foto's") */}
  <dialog
    id="photo-lightbox-modal"
    class="backdrop:bg-black/80 bg-transparent p-0 max-w-5xl w-full rounded-3xl m-auto"
  >
    <div class="bg-surface-pure p-6 rounded-3xl border border-border-hairline max-h-[90vh] overflow-y-auto space-y-6">
      <div class="flex items-center justify-between sticky top-0 bg-surface-pure/95 backdrop-blur-xs py-2 z-10 border-b border-border-hairline">
        <h3 class="text-lg font-extrabold text-text-charcoal">
          Fotogalerij – {venue.name} ({photos.length} foto's)
        </h3>
        <button
          id="close-lightbox-btn"
          type="button"
          class="px-4 py-1.5 rounded-full bg-text-charcoal text-surface-pure text-xs font-bold cursor-pointer"
        >
          Sluiten ✕
        </button>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {photos.map((photo) => (
          <figure class="rounded-2xl overflow-hidden border border-border-hairline bg-surface-subtle">
            <img src={photo.url} alt={photo.alt_nl} loading="lazy" class="w-full aspect-[16/10] object-cover" />
            <figcaption class="p-3 text-xs font-semibold text-text-charcoal flex items-center justify-between">
              <span>{photo.alt_nl}</span>
              {photo.badge_nl && (
                <span class="px-2 py-0.5 rounded-full bg-badge-teal-bg text-primary font-bold">
                  {photo.badge_nl}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </dialog>

  <Footer />
</BaseLayout>

<script>
  const dialog = document.getElementById('photo-lightbox-modal') as HTMLDialogElement | null;
  const openTriggers = document.querySelectorAll('.open-lightbox-trigger');
  const closeBtn = document.getElementById('close-lightbox-btn');

  openTriggers.forEach((el) => {
    el.addEventListener('click', () => {
      dialog?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Delen & Opslaan actions
  const shareBtn = document.getElementById('detail-share-btn');
  shareBtn?.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: window.location.href });
      } else {
        await navigator.clipboard.writeText(window.location.href);
        shareBtn.textContent = '✓ Link gekopieerd';
      }
    } catch {
      // Ignore cancel
    }
  });

  const saveBtn = document.getElementById('detail-save-btn');
  const saveLabel = document.getElementById('detail-save-label');
  const saveIcon = document.getElementById('detail-save-icon');
  const venueId = saveBtn?.getAttribute('data-venue-id');

  function syncSaveState() {
    if (!venueId || !saveLabel || !saveIcon) return;
    try {
      const favs: string[] = JSON.parse(localStorage.getItem('zwemkaart_favorites') || '[]');
      const saved = favs.includes(venueId);
      saveLabel.textContent = saved ? 'Opgeslagen' : 'Opslaan';
      saveIcon.setAttribute('fill', saved ? 'currentColor' : 'none');
    } catch {
      // Ignore
    }
  }

  syncSaveState();

  saveBtn?.addEventListener('click', () => {
    if (!venueId) return;
    try {
      const favs: string[] = JSON.parse(localStorage.getItem('zwemkaart_favorites') || '[]');
      const next = favs.includes(venueId) ? favs.filter((id) => id !== venueId) : [...favs, venueId];
      localStorage.setItem('zwemkaart_favorites', JSON.stringify(next));
      syncSaveState();
    } catch {
      // Ignore
    }
  });
</script>
