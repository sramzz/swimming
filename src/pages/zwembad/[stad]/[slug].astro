---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WaterTreatmentBadge from '../../../components/WaterTreatmentBadge.astro';
import AlertBanner from '../../../components/AlertBanner.astro';
import LazyGoogleMapIframe from '../../../components/LazyGoogleMapIframe.astro';
import StickyBookingWidgetIsland from '../../../components/islands/StickyBookingWidgetIsland';
import { getBuildDatabase } from '../../../db/runtime-db';
import { listAllVenues, getVenueByCityAndSlug } from '../../../db/queries';
import { buildVenueJsonLd, formatEuroCentsNl } from '../../../domain/seo-aggregator';
import { parseVenuePhotos } from '../../../domain/venue-photos';
import { resolveVenueScheduleAndAlerts } from '../../../machines/schedule-resolver';
import { evaluateCurrentOpenStatus } from '../../../domain/open-status';

export async function getStaticPaths() {
  const db = getBuildDatabase();
  const venues = listAllVenues(db);
  db.close();
  return venues.map((v) => ({
    params: { stad: v.municipality_slug, slug: v.slug },
  }));
}

const { stad, slug } = Astro.params;
const db = getBuildDatabase();
const venue = getVenueByCityAndSlug(db, stad!, slug!);
db.close();

if (!venue) {
  throw new Error(`Venue not found: ${stad}/${slug}`);
}

const photos = parseVenuePhotos(venue);
const mainPhoto = photos[0];
const sidePhotos = photos.slice(1, 5);

const transitChips: Array<{ icon: string; title: string; subtitle: string }> = venue.transit_chips_json
  ? JSON.parse(venue.transit_chips_json)
  : [];

const scheduleResolution = resolveVenueScheduleAndAlerts({
  todayIsoDate: '2026-10-21',
  isOutdoorOrOpenWater:
    venue.venue_type === 'OPEN_WATER_NATURAL' || venue.venue_type === 'OUTDOOR_SEASONAL_POOL',
  vacationRegion: venue.municipality_slug === 'eindhoven' ? 'zuid' : venue.municipality_slug === 'utrecht' ? 'midden' : 'noord',
  publicHolidayNameNl: null,
  activeVacationNameNl: venue.municipality_slug === 'eindhoven' ? null : 'Herfstvakantie',
  knmiAlert: null,
  outdoorWaterQualityState: 'CLEAN_APPROVED',
  outdoorWaterTempCelsius: venue.outdoor_temp_celsius,
  periods: [
    {
      id: 'period-herfst',
      scheduleType: 'SCHOOL_VACATION',
      titleNl: 'Herfstvakantierooster 2026',
      validFrom: '2026-10-17',
      validTo: '2026-10-25',
      priority: 50,
      verificationState: 'VERIFIED_PUBLISHED',
    },
  ],
});

const openStatus = evaluateCurrentOpenStatus(venue.slots, {
  isoDayOfWeek: 3,
  currentTimeHHMM: '08:15',
});

const adultTariff = venue.tariffs.find((t) => t.tariff_category === 'SINGLE_ADULT');
const childTariff = venue.tariffs.find((t) => t.tariff_category === 'SINGLE_CHILD');
const tenPassTariff = venue.tariffs.find(
  (t) => t.tariff_category === 'TEN_PASS' || t.tariff_category === 'MULTI_PASS_10'
);

const dayNamesNl: Record<number, string> = {
  1: 'Maandag',
  2: 'Dinsdag',
  3: 'Woensdag',
  4: 'Donderdag',
  5: 'Vrijdag',
  6: 'Zaterdag',
  7: 'Zondag',
};

const venueJsonLd = buildVenueJsonLd({
  name: venue.name,
  slug: venue.slug,
  citySlug: venue.municipality_slug,
  cityName: venue.municipality_slug,
  streetAddress: venue.street_address,
  postcode: venue.postcode_pc6,
  lat: venue.lat,
  lng: venue.lng,
  ratingScore: venue.rating_score,
  ratingCount: venue.rating_count,
  minPriceCents: venue.min_single_price_cents,
  waterTreatment: venue.primary_water_treatment,
});

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Nederland',
      item: 'https://zwemkaart.nl/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: venue.municipality_slug.charAt(0).toUpperCase() + venue.municipality_slug.slice(1),
      item: `https://zwemkaart.nl/steden/${venue.municipality_slug}/banenzwemmen`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: venue.name,
      item: `https://zwemkaart.nl/zwembad/${venue.municipality_slug}/${venue.slug}`,
    },
  ],
};

const isOpenWater = venue.venue_type === 'OPEN_WATER_NATURAL';
const primaryWaitlistOffering = venue.offerings[0] ?? null;

interface ZwemwaterMeta {
  spotid: number;
  statusTextNl: string | null;
  recentMeasurementStatusNl: string | null;
  entranceFeeCode: string | null;
  isPaidAccess: boolean;
  waterQuality4YearClassNl: 'uitstekend' | 'goed' | 'aanvaardbaar' | 'slecht' | null;
  locationOwnerNl: string | null;
  descriptionNl: string | null;
  seasonTextNl: string | null;
  waterProfileUrl: string | null;
  infoBoardUrl: string | null;
  officialPhotoUrls: string[];
  featuresNl: string[];
  restrictionsNl: string[];
  warnings: Array<{ titleNl: string; bodyNl: string }>;
}

const zwemwaterMeta: ZwemwaterMeta | null = venue.zwemwater_metadata_json
  ? JSON.parse(venue.zwemwater_metadata_json)
  : null;
---
<BaseLayout
  title={`${venue.name} - Prijzen, Banenzwemmen & Zwemles | Zwemkaart.nl`}
  description={`Bekijk actuele entreeprijzen, banenzwemmen tijden, watertemperatuur en Zwem-ABC wachttijden bij ${venue.name}.`}
  canonicalPath={`/zwembad/${venue.municipality_slug}/${venue.slug}`}
  jsonLd={[venueJsonLd, breadcrumbJsonLd]}
>
  <Header />
  <main class="max-w-7xl mx-auto px-4 md:px-8 pt-6 pb-16 flex-1 w-full">
    {/* Breadcrumb Pathway (Photo 4) */}
    <nav aria-label="Broodkruimelpad" class="text-xs font-semibold text-text-muted mb-4 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-text-charcoal transition-colors">Nederland</a>
      <span>›</span>
      <a href={`/steden/${venue.municipality_slug}`} class="hover:text-text-charcoal transition-colors capitalize">
        {venue.municipality_slug}
      </a>
      <span>›</span>
      <span class="text-text-charcoal font-bold">{venue.name}</span>
    </nav>

    <AlertBanner
      severity={scheduleResolution.bannerSeverity}
      messageNl={scheduleResolution.bannerNl}
      wetsuitMessageNl={scheduleResolution.wetsuitBannerNl}
    />

    {/* Facility Header & Delen / Opslaan Actions (Photo 4) */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
            ● {openStatus.badgeNl}
          </span>
          {venue.featured_badge_nl && (
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-badge-teal-bg text-primary">
              {venue.featured_badge_nl}
            </span>
          )}
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-text-charcoal tracking-tight">
          {venue.slug === 'de-mirandabad'
            ? 'Zwemcentrum De Mirandabad – Subtropisch & Wedstrijdbad'
            : venue.name}
        </h1>
        <div class="flex flex-wrap items-center gap-y-2 gap-x-3 mt-2 text-sm text-text-muted">
          {venue.rating_score && (
            <span class="flex items-center font-bold text-text-charcoal">
              <span class="text-amber-500 mr-1">★</span>
              {venue.rating_score} ({venue.rating_count} reviews)
            </span>
          )}
          {venue.municipal_keurmerk_label && (
            <>
              <span>•</span>
              <span class="inline-flex items-center gap-1 text-primary font-semibold">
                <span>✓</span>
                {venue.municipal_keurmerk_label}
              </span>
            </>
          )}
          {venue.is_nrz_licensed === 1 && (
            <>
              <span>•</span>
              <span>Officiële KNZB &amp; NRZ Zwemlesaanbieder</span>
            </>
          )}
          <WaterTreatmentBadge treatment={venue.primary_water_treatment} />
        </div>
      </div>

      {/* Delen & Opslaan Buttons (Photo 4) */}
      <div class="flex items-center gap-2 shrink-0">
        <button
          id="detail-share-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-bold text-text-charcoal hover:bg-surface-subtle border border-transparent hover:border-border-hairline transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
          </svg>
          <span class="underline">Delen</span>
        </button>

        <button
          id="detail-save-btn"
          type="button"
          data-venue-id={venue.id}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-bold text-text-charcoal hover:bg-surface-subtle border border-transparent hover:border-border-hairline transition-all cursor-pointer"
        >
          <svg id="detail-save-icon" class="w-4 h-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          <span id="detail-save-label" class="underline">Opslaan</span>
        </button>
      </div>
    </div>

    {/* AIRBNB 5-PHOTO HERO GRID (Photo 4) */}
    <section
      aria-label="Fotogalerij"
      class="relative grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-2.5 h-[320px] md:h-[460px] rounded-2xl overflow-hidden mb-10 shadow-xs"
    >
      {/* 1. Large Left Hero Tile (Spans 2 cols, 2 rows) */}
      <div class="relative md:col-span-2 md:row-span-2 overflow-hidden group cursor-pointer bg-surface-container open-lightbox-trigger">
        <img
          src={mainPhoto.url}
          alt={mainPhoto.alt_nl}
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors"></div>
        {mainPhoto.badge_nl && (
          <div class="absolute top-4 left-4 bg-surface-pure/95 backdrop-blur-xs px-3 py-1 rounded-full text-xs font-bold text-primary shadow-sm">
            {mainPhoto.badge_nl}
          </div>
        )}
      </div>

      {/* 2–5. Four Right Sub-Tiles */}
      {sidePhotos.map((photo, idx) => (
        <div class="relative overflow-hidden group cursor-pointer bg-surface-container hidden md:block open-lightbox-trigger">
          <img
            src={photo.url}
            alt={photo.alt_nl}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
          <div class="absolute inset-0 bg-black/5 group-hover:bg-transparent transition-colors"></div>
          {photo.badge_nl && idx < 3 && (
            <span class="absolute bottom-2.5 left-2.5 bg-surface-pure/90 backdrop-blur-xs px-2.5 py-0.5 rounded-md text-[11px] font-bold text-text-charcoal shadow-2xs">
              {photo.badge_nl}
            </span>
          )}
          {idx === 3 && (
            <button
              type="button"
              class="open-lightbox-trigger absolute bottom-3.5 right-3.5 bg-surface-pure text-text-charcoal text-xs font-bold px-3.5 py-2 rounded-full border border-border-hairline shadow-md hover:scale-105 transition-transform flex items-center gap-1.5 cursor-pointer"
            >
              <span>☷</span>
              <span>Toon alle 28 foto's</span>
            </button>
          )}
        </div>
      ))}

      {/* Mobile Show All Photos Pill */}
      <button
        type="button"
        class="open-lightbox-trigger md:hidden absolute bottom-3 right-3 bg-surface-pure/95 text-text-charcoal text-xs font-bold px-3.5 py-2 rounded-full border border-border-hairline shadow-md flex items-center gap-1.5"
      >
        <span>☷</span>
        <span>Toon alle foto's ({photos.length})</span>
      </button>
    </section>

    {/* MAIN CONTENT SPLIT: Left 8 Cols (65%) vs Right 4 Cols (35% Sticky Booking Widget) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8 flex flex-col gap-9 divide-y divide-border-hairline">
        {/* Host / Operator Header & 5-Item Icon Highlights Strip (Photo 4) */}
        <section class="pt-1">
          <div class="flex items-center justify-between gap-4 pb-6 border-b border-border-hairline">
            <div>
              <h2 class="text-xl md:text-2xl font-extrabold text-text-charcoal">
                {isOpenWater
                  ? 'Officiële Open-Water Zwemlocatie & Natuurstrand'
                  : 'Gemeentelijk Zwemcomplex met Binnen- & Buitenbaden'}
              </h2>
              <p class="text-sm text-text-muted mt-1">
                Beheerd door {venue.operator_name ?? 'Gemeentelijk Sportbedrijf'} •{' '}
                {venue.is_nrz_licensed
                  ? 'Erkend door NRZ (Nationale Raad Zwemveiligheid)'
                  : 'Gecontroleerd volgens landelijke kwaliteitsnormen'}
              </p>
            </div>
            <div class="relative w-14 h-14 rounded-full bg-badge-teal-bg flex items-center justify-center border border-primary/20 shrink-0">
              <span class="text-primary text-2xl">🏊</span>
              <span class="absolute -bottom-1 -right-1 w-5 h-5 bg-primary rounded-full text-on-primary flex items-center justify-center text-[10px] font-bold shadow-xs">
                ✓
              </span>
            </div>
          </div>

          {/* 5-Item Icon Highlights Strip (Photo 4) */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-6">
            <div class="flex gap-3.5 items-start">
              <div class="w-10 h-10 rounded-full bg-badge-teal-bg flex items-center justify-center text-primary font-bold shrink-0">
                📏
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-charcoal">
                  {isOpenWater ? 'Ruime Open-Water Zwemzone' : '25m & 50m Banen'}
                </h3>
                <p class="text-xs text-text-muted mt-0.5 leading-relaxed">
                  {isOpenWater
                    ? 'Gemarkeerde zwemzone geschikt voor recreatief zwemmen, borstcrawl en triatlontraining.'
                    : 'Ideaal voor conditiezwemmen, borstcrawl en KNZB-training.'}
                </p>
              </div>
            </div>

            <div class="flex gap-3.5 items-start">
              <div class="w-10 h-10 rounded-full bg-badge-teal-bg flex items-center justify-center text-primary font-bold shrink-0">
                🌊
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-charcoal">
                  {venue.venue_type === 'SUBTROPICAL_PARADISE'
                    ? 'Subtropisch golfslagbad'
                    : isOpenWater
                      ? 'Rijkswaterstaat Watercontrole'
                      : 'Verwarmd Doelgroepen- & Recreatiebad'}
                </h3>
                <p class="text-xs text-text-muted mt-0.5 leading-relaxed">
                  {venue.venue_type === 'SUBTROPICAL_PARADISE'
                    ? 'Elk heel uur actieve golfslag en verwarmd tot 31.0°C.'
                    : isOpenWater
                      ? 'Periodieke controle op blauwalg en bacteriologische zwemwaterkwaliteit.'
                      : 'Comfortabel verwarmd zwemwater voor gezinnen, ouderen en aquasport.'}
                </p>
              </div>
            </div>

            <div class="flex gap-3.5 items-start">
              <div class="w-10 h-10 rounded-full bg-badge-teal-bg flex items-center justify-center text-primary font-bold shrink-0">
                🎓
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-charcoal">Zwemles A/B/C</h3>
                <p class="text-xs text-text-muted mt-0.5 leading-relaxed">
                  {venue.is_nrz_licensed
                    ? 'Gecertificeerde NRZ instructeurs met diplomagarantie.'
                    : 'Bekijk zwemlesmogelijkheden en wachttijden bij zwemscholen in deze gemeente.'}
                </p>
              </div>
            </div>

            <div class="flex gap-3.5 items-start">
              <div class="w-10 h-10 rounded-full bg-badge-teal-bg flex items-center justify-center text-primary font-bold shrink-0">
                ♿
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-charcoal">Toegankelijkheid</h3>
                <p class="text-xs text-text-muted mt-0.5 leading-relaxed">
                  {venue.has_wheelchair_lift
                    ? 'Rolstoellift, invalidentoilet en drempelvrije kleedruimtes.'
                    : 'Openbare toegang met kleedvoorzieningen en rustpunten.'}
                </p>
              </div>
            </div>

            <div class="flex gap-3.5 items-start md:col-span-2">
              <div class="w-10 h-10 rounded-full bg-badge-teal-bg flex items-center justify-center text-emerald-700 font-bold shrink-0">
                💧
              </div>
              <div>
                <h3 class="text-sm font-bold text-text-charcoal">
                  {venue.primary_water_treatment === 'SALT_ELECTROLYSIS'
                    ? 'Zoutelektrolyse'
                    : venue.primary_water_treatment === 'NATURAL_UNTREATED'
                      ? 'Onbehandeld Natuurwater'
                      : 'Moderne Waterbehandeling & Filtratie'}
                </h3>
                <p class="text-xs text-text-muted mt-0.5 leading-relaxed">
                  {venue.primary_water_treatment === 'SALT_ELECTROLYSIS'
                    ? 'Zacht zoutwater & huidvriendelijk (ideaal voor gevoelige huid en allergieën).'
                    : venue.primary_water_treatment === 'NATURAL_UNTREATED'
                      ? '100% natuurlijk buitenwater zonder chloor; gecontroleerd door provincie en waterschap.'
                      : 'Continu gecontroleerd op pH, vrij chloor en kristalheldere doorzichtigheid.'}
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* Faciliteiten & Live Sensoren / Baden & Watertemperatuur (Photo 4) */}
        <section class="pt-8">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <h2 class="text-xl font-extrabold text-text-charcoal">Baden &amp; Watertemperatuur</h2>
            <span class="text-xs text-emerald-700 font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Actuele bassin- &amp; sensordata
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-5">
            {venue.basins.map((b, idx) => (
              <div class="p-4 rounded-xl border border-border-hairline bg-surface-pure shadow-2xs">
                <span class="text-[11px] font-bold text-text-muted uppercase block">{b.name_nl}</span>
                <div
                  class={`text-2xl font-extrabold mt-1 ${
                    idx === 0 ? 'text-primary' : idx === 1 ? 'text-secondary' : 'text-accent-seasonal'
                  }`}
                >
                  {b.target_temp_celsius
                    ? `${b.target_temp_celsius.toFixed(1)}°C`
                    : venue.outdoor_temp_celsius
                      ? `${venue.outdoor_temp_celsius.toFixed(1)}°C`
                      : 'Natuurwater'}
                </div>
                {b.length_meters && (
                  <p class="text-xs text-text-muted mt-1">
                    {b.length_meters}m bad {b.lanes_count ? `• ${b.lanes_count} banen` : ''}
                  </p>
                )}
                {b.warm_water_day_note_nl && (
                  <p class="text-xs font-medium text-text-muted mt-1">{b.warm_water_day_note_nl}</p>
                )}
              </div>
            ))}

            {/* 4th Sensor Card: Waterbehandeling */}
            <div class="p-4 rounded-xl border border-border-hairline bg-surface-pure shadow-2xs">
              <div class="text-[11px] font-bold text-text-muted flex items-center justify-between">
                <span>WATERBEHANDELING</span>
                <span class="text-emerald-600">💧</span>
              </div>
              <div class="mt-1 text-base font-extrabold text-text-charcoal flex flex-wrap items-center gap-1.5">
                <span>
                  {venue.primary_water_treatment === 'SALT_ELECTROLYSIS'
                    ? 'Zoutelektrolyse'
                    : venue.primary_water_treatment === 'NATURAL_UNTREATED'
                      ? 'Natuurwater'
                      : 'UV & Chloor'}
                </span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                  Optimaal
                </span>
              </div>
              <p class="mt-1 text-xs text-text-muted">
                {venue.primary_water_treatment === 'SALT_ELECTROLYSIS'
                  ? 'Geen rode ogen of chloorlucht. Huidvriendelijk systeem.'
                  : 'Voldoet aan alle Nederlandse hygiëne- en zwemwaternormen.'}
              </p>
            </div>
          </div>
        </section>

        {/* Banenzwemmen & Openingstijden */}
        {venue.slots.length > 0 && (
          <section id="banenzwemmen" class="pt-8">
            <h2 class="text-xl font-extrabold text-text-charcoal mb-4">Banenzwemmen &amp; Openingstijden</h2>
            <div class="border border-border-hairline rounded-2xl divide-y divide-border-hairline overflow-hidden bg-surface-pure">
              {venue.slots.map((s) => (
                <div class="p-4 flex flex-wrap items-center justify-between gap-2 text-sm hover:bg-surface-subtle transition-colors">
                  <div>
                    <span class="font-bold text-text-charcoal">{dayNamesNl[s.day_of_week] ?? 'Dag'}: </span>
                    <span class="font-medium text-text-charcoal">{s.label_nl}</span>
                    {s.notes_nl && (
                      <span class="block text-xs text-text-muted">{s.notes_nl}</span>
                    )}
                  </div>
                  <span class="px-3 py-1 rounded-full bg-surface-subtle font-bold text-text-charcoal text-xs">
                    {s.start_time} – {s.end_time}
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* Tarieven & Abonnementen */}
        {venue.tariffs.length > 0 && (
          <section class="pt-8">
            <h2 class="text-xl font-extrabold text-text-charcoal mb-2">Tarieven &amp; Abonnementen</h2>
            <p class="text-xs text-text-muted mb-4">
              Officiële tarieven 2026. {venue.municipal_pass_name ? `${venue.municipal_pass_name} geeft recht op korting.` : ''}
            </p>
            <div class="border border-border-hairline rounded-2xl divide-y divide-border-hairline overflow-hidden bg-surface-pure">
              {venue.tariffs.map((t) => (
                <div
                  class={`p-4 flex items-center justify-between hover:bg-surface-subtle transition-colors ${
                    t.is_highlighted ? 'bg-badge-teal-bg/25' : ''
                  }`}
                >
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-text-charcoal">{t.title_nl}</span>
                      {t.badge_nl && (
                        <span class="text-[10px] bg-primary text-on-primary px-2 py-0.5 rounded-full font-bold">
                          {t.badge_nl}
                        </span>
                      )}
                    </div>
                    {t.subtitle_nl && <p class="text-xs text-text-muted mt-0.5">{t.subtitle_nl}</p>}
                  </div>
                  <span class="text-lg font-extrabold text-text-charcoal">
                    {formatEuroCentsNl(t.price_cents)}
                  </span>
                </div>
              ))}
            </div>
            {venue.municipal_pass_discount_nl && (
              <p class="mt-3 text-xs text-emerald-800 bg-emerald-50 p-3 rounded-xl border border-emerald-200">
                <strong>{venue.municipal_pass_name}:</strong> {venue.municipal_pass_discount_nl}
              </p>
            )}
          </section>
        )}

        {/* DEDICATED SECTION: Zwemlessen & Diploma A, B & C Timeline + Waitlist Tracker (Photo 4) */}
        {(venue.offerings.length > 0 || !isOpenWater) && (
          <section class="pt-8">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div>
                <span class="text-[11px] text-primary uppercase tracking-wider font-extrabold">
                  Opleiding &amp; Veiligheid
                </span>
                <h2 class="text-xl font-extrabold text-text-charcoal mt-0.5">
                  Zwemlessen &amp; Diploma A, B &amp; C
                </h2>
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-badge-teal-bg text-primary text-xs font-bold">
                <span>✓</span>
                <span>Licentie Nationale Zwemdiploma's</span>
              </span>
            </div>

            <p class="text-sm text-text-muted mb-5 leading-relaxed">
              Bij {venue.name} leren kinderen op een veilige, speelse en pedagogisch verantwoorde wijze zwemmen volgens het officiële Zwem-ABC van de NRZ en KNZB.
            </p>

            {/* 4-Phase Zwem-ABC Timeline (Photo 4) */}
            <div class="space-y-3 mb-6">
              <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-bold flex items-center justify-center text-xs shrink-0">
                    1
                  </span>
                  <div>
                    <h3 class="text-xs font-bold text-text-charcoal">
                      Fase 1: Watergewenning &amp; Overleving (4–5 jaar)
                    </h3>
                    <p class="text-xs text-text-muted">
                      Oriëntatie onder water, drijven op buik en rug, en zelfstandig uit het bad klimmen.
                    </p>
                  </div>
                </div>
                <span class="text-[11px] font-bold px-2.5 py-1 bg-surface-pure rounded-full border border-border-hairline text-text-muted shrink-0 self-start sm:self-auto">
                  Duur: ~3 mnd
                </span>
              </div>

              <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-bold flex items-center justify-center text-xs shrink-0">
                    2
                  </span>
                  <div>
                    <h3 class="text-xs font-bold text-text-charcoal">Fase 2: Diploma A Basisvaardigheden</h3>
                    <p class="text-xs text-text-muted">
                      Schoolslag, enkelvoudige rugslag, borst- en rugcrawl, watertrappen en gekleed zwemmen.
                    </p>
                  </div>
                </div>
                <span class="text-[11px] font-bold px-2.5 py-1 bg-surface-pure rounded-full border border-border-hairline text-text-muted shrink-0 self-start sm:self-auto">
                  Diplomagarantie
                </span>
              </div>

              <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-bold flex items-center justify-center text-xs shrink-0">
                    3
                  </span>
                  <div>
                    <h3 class="text-xs font-bold text-text-charcoal">Fase 3: Diploma B Conditie &amp; Diep Water</h3>
                    <p class="text-xs text-text-muted">
                      Grotere afstanden, duiken door een zeil op 6 meter afstand en uithoudingsvermogen.
                    </p>
                  </div>
                </div>
                <span class="text-[11px] font-bold px-2.5 py-1 bg-surface-pure rounded-full border border-border-hairline text-text-muted shrink-0 self-start sm:self-auto">
                  Vervolgles
                </span>
              </div>

              <div class="p-3.5 rounded-xl border border-border-hairline bg-surface-subtle flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-bold flex items-center justify-center text-xs shrink-0">
                    4
                  </span>
                  <div>
                    <h3 class="text-xs font-bold text-text-charcoal">Fase 4: Diploma C Complete Zwemveiligheid</h3>
                    <p class="text-xs text-text-muted">
                      Complete zelfredzaamheid in golfslag, open-water situaties en gekleed met jas.
                    </p>
                  </div>
                </div>
                <span class="text-[11px] font-bold px-2.5 py-1 bg-surface-pure rounded-full border border-border-hairline text-text-muted shrink-0 self-start sm:self-auto">
                  Mastery
                </span>
              </div>
            </div>

            {/* Live Wachttijd & Beschikbaarheid Tracker Card */}
            {venue.offerings.map((o) => (
              <div class="p-5 rounded-2xl border-2 border-primary/20 bg-badge-teal-bg/40 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-3">
                <div class="space-y-1.5">
                  {o.direct_spots_note_nl && (
                    <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-primary text-on-primary rounded-full text-[11px] font-bold">
                      <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                      <span>{o.direct_spots_note_nl}</span>
                    </div>
                  )}
                  <h3 class="font-extrabold text-base text-text-charcoal">
                    {o.provider_name} ({o.diploma_track})
                  </h3>
                  <p class="text-sm text-text-muted">
                    Gemiddelde wachttijd:{' '}
                    <strong class="text-text-charcoal">
                      {o.current_waitlist_weeks_min} tot {o.current_waitlist_weeks_max} weken
