                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-badge-teal-bg text-primary text-xs font-bold hover:underline"
              >
                <span>🌊</span>
                <span>Geregistreerd op Zwemwater.nl ↗</span>
              </a>
