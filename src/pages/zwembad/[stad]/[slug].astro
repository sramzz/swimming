                </div>
                {(o.registration_url || venue.official_website_url) && (
                  <a
                    href={o.registration_url || venue.official_website_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 px-5 py-2.5 rounded-full bg-primary hover:bg-primary-container text-on-primary text-xs font-bold shadow-xs transition-all"
                  >
                    Inschrijven op officiële website ↗
                  </a>
                )}
              </div>
            ))}
          </section>
        )}

        {/* DEDICATED SECTION FOR OPEN WATER: Officiële Zwemwater.nl Locatie-informatie, Restricties & Informatiebord */}
        {isOpenWater && (
          <section id="zwemwater-dossier" class="pt-8">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <div>
                <span class="text-[11px] text-primary uppercase tracking-wider font-extrabold">
                  Rijkswaterstaat &amp; Provincie Register
                </span>
                <h2 class="text-xl font-extrabold text-text-charcoal mt-0.5">
