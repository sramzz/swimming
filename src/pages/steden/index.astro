---
// src/pages/steden/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBuildDatabase } from '../../db/runtime-db';

interface ConstituentWoonplaats {
  slug: string;
  name: string;
  municipality_slug: string;
  venue_count: number;
}

const db = getBuildDatabase();

const provinces = db
  .prepare(
    `SELECT m.province_slug, m.province_name, COUNT(v.id) as venue_count
     FROM municipalities m
     JOIN venues v ON v.municipality_slug = m.slug
     GROUP BY m.province_slug
     ORDER BY m.province_name ASC`
  )
  .all() as Array<{ province_slug: string; province_name: string; venue_count: number }>;

const cities = db
  .prepare(
    `SELECT m.slug, m.name, m.province_name, COUNT(v.id) as venue_count,
            SUM(CASE WHEN v.venue_type != 'OPEN_WATER_NATURAL' THEN 1 ELSE 0 END) as indoor_count,
            SUM(CASE WHEN v.venue_type = 'OPEN_WATER_NATURAL' THEN 1 ELSE 0 END) as outdoor_count
     FROM municipalities m
     JOIN venues v ON v.municipality_slug = m.slug
     GROUP BY m.slug
     ORDER BY venue_count DESC, m.name ASC`
  )
  .all() as Array<{
    slug: string;
    name: string;
    province_name: string;
    venue_count: number;
    indoor_count: number;
    outdoor_count: number;
  }>;

const constituentWoonplaatsen = db
  .prepare(
    `SELECT w.slug, w.name, w.municipality_slug, COUNT(v.id) as venue_count
     FROM woonplaatsen w
     JOIN venues v ON v.woonplaats_id = w.id
     WHERE w.slug != w.municipality_slug
     GROUP BY w.id
     ORDER BY venue_count DESC, w.name ASC`
  )
  .all() as ConstituentWoonplaats[];

db.close();

const woonplaatsenByMunicipality = new Map<string, ConstituentWoonplaats[]>();
for (const wp of constituentWoonplaatsen) {
  const list = woonplaatsenByMunicipality.get(wp.municipality_slug) ?? [];
  list.push(wp);
  woonplaatsenByMunicipality.set(wp.municipality_slug, list);
}
---
<BaseLayout
  title="Alle Steden & Provincies – Zwembaden in Nederland | Zwemkaart.nl"
  description={`Overzicht van alle ${cities.length} Nederlandse gemeenten en 12 provincies met zwembaden, banenzwemmen, Zwem-ABC zwemles en natuurwater.`}
  canonicalPath="/steden"
>
  <Header />
  <main class="max-w-7xl mx-auto px-4 md:px-8 py-8 flex-1 w-full">
    <nav aria-label="Broodkruimelpad" class="text-xs text-text-muted mb-4 flex items-center gap-2">
      <a href="/" class="hover:underline">Nederland</a>
      <span>›</span>
      <span class="text-text-charcoal font-semibold">Alle Steden &amp; Provincies</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-text-charcoal mb-2">
        Zwembaden &amp; Zwemwater per Stad en Provincie
      </h1>
      <p class="text-sm text-text-muted max-w-3xl">
        Kies uw provincie of gemeente om direct binnenbaden, subtropische zwemparadijzen, Zwem-ABC wachttijden en officiële Rijkswaterstaat buitenzwemplekken te bekijken.
      </p>
    </div>

    {/* 12 Provinces Grid */}
    <section class="mb-10">
      <h2 class="text-lg font-extrabold text-text-charcoal mb-4">
        12 Provincies van Nederland
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {provinces.map((p) => (
          <a
            href={`/provincies/${p.province_slug}`}
            class="p-4 rounded-2xl border border-border-hairline bg-surface-pure hover:border-primary hover:shadow-md transition-all flex flex-col justify-between"
          >
            <span class="font-bold text-sm text-text-charcoal">{p.province_name}</span>
            <span class="text-xs text-primary font-semibold mt-1">{p.venue_count} locaties →</span>
          </a>
        ))}
      </div>
    </section>

    {/* Searchable All Municipalities Directory */}
    <section>
      <div class="flex flex-wrap items-center justify-between gap-4 mb-5 pb-4 border-b border-border-hairline">
        <h2 class="text-lg font-extrabold text-text-charcoal">
          Alle Gemeenten met Zwemlocaties ({cities.length})
        </h2>
        <div class="w-full sm:w-80">
          <label for="city-directory-search" class="sr-only">Zoek gemeente</label>
          <input
            id="city-directory-search"
            type="search"
            placeholder="Filter op gemeente, dorp of provincie..."
            class="w-full px-4 py-2 rounded-full border border-border-strong bg-surface-pure text-xs md:text-sm"
          />
        </div>
      </div>

      <div id="city-directory-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {cities.map((c) => {
          const wps = woonplaatsenByMunicipality.get(c.slug) ?? [];
          const wpNames = wps.map((w) => w.name.toLowerCase()).join(' ');
          return (
            <div
              data-city-name={`${c.name.toLowerCase()} ${c.province_name.toLowerCase()} ${wpNames}`.trim()}
              class="city-directory-card p-3.5 rounded-xl border border-border-hairline bg-surface-pure hover:border-primary hover:shadow-xs transition-all flex flex-col justify-between gap-2"
            >
              <div class="flex items-center justify-between gap-2">
                <a href={`/steden/${c.slug}`} class="min-w-0 group flex-1">
                  <div class="font-bold text-sm text-text-charcoal group-hover:text-primary transition-colors truncate">{c.name}</div>
                  <div class="text-[11px] text-text-muted truncate">{c.province_name}</div>
                </a>
                <a
                  href={`/steden/${c.slug}`}
                  class="shrink-0 px-2.5 py-1 rounded-full bg-badge-teal-bg text-primary text-xs font-bold hover:bg-primary hover:text-white transition-colors"
                >
                  {c.venue_count}
                </a>
              </div>
              {wps.length > 0 && (
                <div class="pt-2 border-t border-border-hairline/60 flex flex-wrap gap-1 items-center">
                  <span class="text-[10px] font-semibold text-text-muted">Kernen:</span>
                  {wps.slice(0, 4).map((wp) => (
                    <a
                      href={`/steden/${wp.slug}`}
                      class="text-[10px] px-1.5 py-0.5 rounded bg-surface-subtle text-text-charcoal hover:bg-primary hover:text-white transition-colors"
                      title={`${wp.name} (${wp.venue_count} locaties)`}
                    >
                      {wp.name}
                    </a>
                  ))}
                  {wps.length > 4 && (
                    <span class="text-[10px] text-text-muted">+{wps.length - 4}</span>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>

    {/* Searchable All Woonplaatsen (Towns & Villages) Directory */}
    <section class="mt-12">
      <div class="mb-5 pb-4 border-b border-border-hairline">
        <h2 class="text-lg font-extrabold text-text-charcoal mb-1">
          Alle Plaatsen &amp; Dorpen (Woonplaatsen) ({constituentWoonplaatsen.length})
        </h2>
        <p class="text-xs text-text-muted">
          Plaatsen, dorpen en kernen met een eigen BAG-woonplaats binnen een grotere gemeente. Zoek direct op plaatsnaam.
        </p>
      </div>

      <div id="woonplaats-directory-grid" class="flex flex-wrap gap-2">
        {constituentWoonplaatsen.map((wp) => (
          <a
            href={`/steden/${wp.slug}`}
            data-city-name={`${wp.name.toLowerCase()} ${wp.municipality_slug.toLowerCase()}`}
            class="city-directory-card text-xs px-3 py-1.5 rounded-full border border-border-hairline bg-surface-pure hover:border-primary hover:text-primary transition-all flex items-center gap-1.5"
          >
            <span class="font-semibold text-text-charcoal">{wp.name}</span>
            <span class="text-[10px] text-text-muted">({wp.venue_count})</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const searchInput = document.getElementById('city-directory-search') as HTMLInputElement | null;
  const cityCards = document.querySelectorAll<HTMLElement>('.city-directory-card');

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    cityCards.forEach((card) => {
      const name = card.dataset.cityName || '';
      card.style.display = q === '' || name.includes(q) ? '' : 'none';
    });
  });
</script>
