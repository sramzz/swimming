---
// src/pages/steden/[stad]/[intent].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import VenueCard from '../../../components/VenueCard.astro';
import { getBuildDatabase } from '../../../db/runtime-db';
import { listVenuesByCity } from '../../../db/queries';
import { shouldGenerateIndexableFacetPage } from '../../../domain/seo-aggregator';

export async function getStaticPaths() {
  const db = getBuildDatabase();
  const cities = db.prepare('SELECT slug, name FROM municipalities').all() as Array<{ slug: string; name: string }>;
  const intents = ['banenzwemmen', 'zwemles', 'buitenwater'] as const;
  const paths: Array<{ params: { stad: string; intent: string }; props: { cityName: string } }> = [];

  for (const city of cities) {
    const allVenues = listVenuesByCity(db, city.slug);
    for (const intent of intents) {
      const matching =
        intent === 'buitenwater'
          ? allVenues.filter((v) => v.venue_type === 'OPEN_WATER_NATURAL' || v.venue_type === 'INDOOR_AND_OUTDOOR')
          : allVenues.filter((v) => v.venue_type !== 'OPEN_WATER_NATURAL');
      if (shouldGenerateIndexableFacetPage(matching.length)) {
        paths.push({ params: { stad: city.slug, intent }, props: { cityName: city.name } });
      }
    }
  }
  db.close();
  return paths;
}

const { stad, intent } = Astro.params;
const { cityName } = Astro.props;
const db = getBuildDatabase();
const allVenues = listVenuesByCity(db, stad!);
db.close();

const venues =
  intent === 'buitenwater'
    ? allVenues.filter((v) => v.venue_type === 'OPEN_WATER_NATURAL' || v.venue_type === 'INDOOR_AND_OUTDOOR')
    : allVenues.filter((v) => v.venue_type !== 'OPEN_WATER_NATURAL');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Nederland',
      item: 'https://zwemkaart.nl/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: cityName,
      item: `https://zwemkaart.nl/steden/${stad}/banenzwemmen`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: intent ? intent.charAt(0).toUpperCase() + intent.slice(1) : '',
      item: `https://zwemkaart.nl/steden/${stad}/${intent}`,
    },
  ],
};
---
<BaseLayout
  title={`${intent} in ${cityName} | Zwemkaart.nl`}
  description={`Overzicht voor ${intent} in ${cityName}.`}
  canonicalPath={`/steden/${stad}/${intent}`}
  jsonLd={breadcrumbJsonLd}
>
  <Header />
  <main class="max-w-7xl mx-auto px-4 md:px-8 py-8 flex-1 w-full">
    <nav aria-label="Broodkruimelpad" class="text-xs text-text-muted mb-4 flex items-center gap-2">
      <a href="/" class="hover:underline">Nederland</a>
      <span>›</span>
      <a href={`/steden/${stad}`} class="hover:underline">{cityName}</a>
      <span>›</span>
      <span class="text-text-charcoal font-semibold capitalize">{intent}</span>
    </nav>

    <h1 class="text-3xl font-extrabold text-text-charcoal capitalize mb-4">{intent} in {cityName}</h1>

    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-5 mb-6 border-b border-border-hairline">
      <a
        href={`/steden/${stad}`}
        class="px-4 py-1.5 rounded-full text-xs font-semibold bg-surface-subtle text-text-charcoal border border-border-hairline hover:border-text-charcoal"
      >
        Alle baden in {cityName}
      </a>
      <a
        href={`/steden/${stad}/banenzwemmen`}
        class={`px-4 py-1.5 rounded-full text-xs font-bold border ${
          intent === 'banenzwemmen'
            ? 'bg-text-charcoal text-surface-pure border-text-charcoal'
            : 'bg-surface-subtle text-text-charcoal border-border-hairline'
        }`}
      >
        Banenzwemmen
      </a>
      <a
        href={`/steden/${stad}/zwemles`}
        class={`px-4 py-1.5 rounded-full text-xs font-bold border ${
          intent === 'zwemles'
            ? 'bg-text-charcoal text-surface-pure border-text-charcoal'
            : 'bg-surface-subtle text-text-charcoal border-border-hairline'
        }`}
      >
        Zwemles A/B/C
      </a>
      <a
        href={`/steden/${stad}/buitenwater`}
        class={`px-4 py-1.5 rounded-full text-xs font-bold border ${
          intent === 'buitenwater'
            ? 'bg-text-charcoal text-surface-pure border-text-charcoal'
            : 'bg-surface-subtle text-text-charcoal border-border-hairline'
        }`}
      >
        Buiten &amp; Natuurwater
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {venues.map((v) => <VenueCard venue={v} />)}
    </div>
  </main>
  <Footer />
</BaseLayout>
