---
// src/pages/steden/[stad]/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import VenueCard from '../../../components/VenueCard.astro';
import { getBuildDatabase } from '../../../db/runtime-db';
import {
  listVenuesByCity,
  listIndexableWoonplaatsen,
  listWoonplaatsenByMunicipality,
  listVenuesByWoonplaats,
  type VenueRow,
  type WoonplaatsWithCountRow,
} from '../../../db/queries';
import {
  buildCityHubTitleNl,
  buildCitySeoSummaryNl,
  buildItemListJsonLd,
  getAvailableCityIntents,
} from '../../../domain/seo-aggregator';
import { parseVenuePhotos } from '../../../domain/venue-photos';

interface Props {
  kind: 'municipality' | 'woonplaats';
  cityName: string;
  municipalitySlug: string;
  municipalityName: string;
}

export async function getStaticPaths() {
  const db = getBuildDatabase();
  const cities = db.prepare('SELECT slug, name FROM municipalities').all() as Array<{ slug: string; name: string }>;
  const munMap = new Map(cities.map((c) => [c.slug, c.name]));

  const paths: Array<{
    params: { stad: string };
    props: Props;
  }> = [];
  const seenSlugs = new Set<string>();

  for (const c of cities) {
    if (listVenuesByCity(db, c.slug).length >= 1) {
      seenSlugs.add(c.slug);
      paths.push({
        params: { stad: c.slug },
        props: {
          kind: 'municipality',
          cityName: c.name,
          municipalitySlug: c.slug,
          municipalityName: c.name,
        },
      });
    }
  }

  const indexableWp = listIndexableWoonplaatsen(db);
  for (const w of indexableWp) {
    if (!seenSlugs.has(w.slug)) {
      seenSlugs.add(w.slug);
      const parentMunName = munMap.get(w.municipality_slug) ?? w.municipality_slug;
      paths.push({
        params: { stad: w.slug },
        props: {
          kind: 'woonplaats',
          cityName: w.name,
          municipalitySlug: w.municipality_slug,
          municipalityName: parentMunName,
        },
      });
    }
  }

  db.close();
  return paths;
}

const { stad } = Astro.params;
const {
  kind = 'municipality',
  cityName,
  municipalitySlug = stad!,
  municipalityName = cityName,
} = Astro.props as Props;

const db = getBuildDatabase();
let venues: VenueRow[] = [];
let subWoonplaatsen: WoonplaatsWithCountRow[] = [];
let nearbyMunVenues: VenueRow[] = [];

if (kind === 'woonplaats') {
  venues = listVenuesByWoonplaats(db, stad!);
  nearbyMunVenues = listVenuesByCity(db, municipalitySlug).filter((v) => v.woonplaats_slug !== stad);
} else {
  venues = listVenuesByCity(db, stad!);
  subWoonplaatsen = listWoonplaatsenByMunicipality(db, stad!, { distinctOnly: true });
}
db.close();

const availableIntents = getAvailableCityIntents(venues);
const paid = venues.filter((v) => v.min_single_price_cents && v.min_single_price_cents > 0);
const cheapest = [...paid].sort((a, b) => (a.min_single_price_cents ?? 9999) - (b.min_single_price_cents ?? 9999))[0];
const summaryNl = buildCitySeoSummaryNl(
  {
    cityName,
    totalVenues: venues.length,
    saltWaterCount: venues.filter((v) => v.primary_water_treatment === 'SALT_ELECTROLYSIS').length,
    cheapestSinglePriceCents: cheapest?.min_single_price_cents ?? null,
    cheapestVenueName: cheapest?.name ?? null,
    shortestWaitlistWeeks: 4,
  },
  { isWoonplaats: kind === 'woonplaats', municipalityName }
);
const pageTitle = buildCityHubTitleNl(cityName, { isWoonplaats: kind === 'woonplaats', municipalityName });

const breadcrumbItems =
  kind === 'woonplaats'
    ? [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Nederland',
          item: 'https://zwemkaart.nl/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: municipalityName,
          item: `https://zwemkaart.nl/steden/${municipalitySlug}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: cityName,
          item: `https://zwemkaart.nl/steden/${stad}`,
        },
      ]
    : [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Nederland',
          item: 'https://zwemkaart.nl/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: cityName,
          item: `https://zwemkaart.nl/steden/${stad}`,
        },
      ];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

const cityItemListJsonLd = buildItemListJsonLd({
  name: `Zwembaden & Zwemwater in ${cityName}`,
  url: `/steden/${stad}`,
  items: venues.map((v) => ({
    name: v.name,
    url: `/zwembad/${v.municipality_slug}/${v.slug}`,
    image: parseVenuePhotos(v)[0]?.url,
  })),
});

const leadPhoto = venues[0] ? parseVenuePhotos(venues[0])[0] : undefined;
---
<BaseLayout
  title={pageTitle}
  description={summaryNl}
  canonicalPath={`/steden/${stad}`}
  ogImage={leadPhoto?.url}
  ogImageAlt={leadPhoto?.alt_nl}
  jsonLd={[breadcrumbJsonLd, cityItemListJsonLd]}
>
  <Header />
  <main class="max-w-7xl mx-auto px-4 md:px-8 py-8 flex-1 w-full">
    <nav aria-label="Broodkruimelpad" class="text-xs text-text-muted mb-4 flex items-center gap-2">
      <a href="/" class="hover:underline">Nederland</a>
      <span>›</span>
      {kind === 'woonplaats' ? (
        <>
          <a href={`/steden/${municipalitySlug}`} class="hover:underline">{municipalityName}</a>
          <span>›</span>
          <span class="text-text-charcoal font-semibold">{cityName}</span>
        </>
      ) : (
        <span class="text-text-charcoal font-semibold">{cityName}</span>
      )}
    </nav>

    <h1 class="text-3xl font-extrabold text-text-charcoal mb-1">Zwembaden in {cityName}</h1>
    {kind === 'woonplaats' && (
      <p class="text-xs text-text-muted mb-3">
        Onderdeel van gemeente <a href={`/steden/${municipalitySlug}`} class="text-primary font-semibold hover:underline">{municipalityName}</a>
      </p>
    )}
    <p class="text-sm text-text-muted mb-4">{summaryNl}</p>

    {kind === 'municipality' && subWoonplaatsen.filter((w) => w.slug !== stad).length > 0 && (
      <div class="mb-5 p-4 bg-surface-subtle rounded-xl border border-border-hairline">
        <h2 class="text-xs font-bold uppercase tracking-wider text-text-muted mb-2.5">
          Plaatsen in gemeente {cityName}
        </h2>
        <div class="flex flex-wrap gap-2">
          {subWoonplaatsen
            .filter((w) => w.slug !== stad)
            .map((w) => (
              <a
                href={`/steden/${w.slug}`}
                class="px-3 py-1.5 rounded-full text-xs font-medium bg-surface-pure text-text-charcoal border border-border-hairline hover:border-text-charcoal transition-colors"
              >
                {w.name} <span class="text-text-muted text-[11px]">({w.venue_count})</span>
              </a>
            ))}
        </div>
      </div>
    )}

    {/* Crawlable SEO Intent Hub Links */}
    {availableIntents.length > 0 && (
      <nav aria-label={`Categorieën in ${cityName}`} class="flex flex-wrap items-center gap-2 mb-4">
        {availableIntents.includes('banenzwemmen') && (
          <a
            href={`/steden/${stad}/banenzwemmen`}
            class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-badge-teal-bg text-primary hover:underline"
          >
            Banenzwemmen in {cityName}
          </a>
        )}
        {availableIntents.includes('zwemles') && (
          <a
            href={`/steden/${stad}/zwemles`}
            class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-badge-teal-bg text-primary hover:underline"
          >
            Zwemles A/B/C in {cityName}
          </a>
        )}
        {availableIntents.includes('buitenwater') && (
          <a
            href={`/steden/${stad}/buitenwater`}
            class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-badge-amber-bg text-accent-seasonal hover:underline"
          >
            Buitenzwemmen &amp; Natuurwater
          </a>
        )}
      </nav>
    )}

    <!-- Interactive Filter Pills for City Overview -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-5 mb-6 border-b border-border-hairline" data-static-filter-bar>
      <button
        type="button"
        data-filter="ALL"
        class="static-filter-pill px-4 py-1.5 rounded-full text-xs font-bold bg-text-charcoal text-surface-pure border border-text-charcoal cursor-pointer transition-all"
      >
        Alle baden ({venues.length})
      </button>
      <button
        type="button"
        data-filter="BINNEN"
        class="static-filter-pill px-4 py-1.5 rounded-full text-xs font-semibold bg-surface-subtle text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all"
      >
        Binnenbaden &amp; Banen
      </button>
      <button
        type="button"
        data-filter="ZWEMLES"
        class="static-filter-pill px-4 py-1.5 rounded-full text-xs font-semibold bg-surface-subtle text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all"
      >
        Zwemles A/B/C
      </button>
      <button
        type="button"
        data-filter="BUITEN"
        class="static-filter-pill px-4 py-1.5 rounded-full text-xs font-semibold bg-surface-subtle text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all"
      >
        Buiten &amp; Natuurwater
      </button>
      <button
        type="button"
        data-filter="SALT_ELECTROLYSIS"
        class="static-filter-pill px-4 py-1.5 rounded-full text-xs font-semibold bg-surface-pure text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all flex items-center gap-1"
      >
        <span class="text-primary">💧</span>
        <span>Zoutelektrolyse</span>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7" id="city-venues-grid">
      {venues.map((v) => <VenueCard venue={v} />)}
    </div>

    {kind === 'woonplaats' && nearbyMunVenues.length > 0 && (
      <section class="mt-12 pt-8 border-t border-border-hairline">
        <h2 class="text-xl font-bold text-text-charcoal mb-4">
          Overige zwemlocaties in gemeente {municipalityName}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {nearbyMunVenues.map((v) => <VenueCard venue={v} />)}
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.static-filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.venue-card-item');
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const mode = pill.dataset.filter || 'ALL';
      pills.forEach((p) => {
        const active = p === pill;
        p.classList.toggle('bg-text-charcoal', active);
        p.classList.toggle('text-surface-pure', active);
        p.classList.toggle('bg-surface-subtle', !active);
        p.classList.toggle('text-text-charcoal', !active);
      });
      cards.forEach((card) => {
        const cat = card.dataset.filterCategory;
        const treat = card.dataset.waterTreatment;
        const nrz = card.dataset.nrz;
        let show = true;
        if (mode === 'BINNEN') show = cat === 'BINNEN' || cat === 'SUBTROPISCH';
        else if (mode === 'BUITEN') show = cat === 'BUITEN';
        else if (mode === 'ZWEMLES') show = nrz === '1' || cat !== 'BUITEN';
        else if (mode === 'SALT_ELECTROLYSIS') show = treat === 'SALT_ELECTROLYSIS';
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
