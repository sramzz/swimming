---
// src/pages/provincies/[provincie].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VenueCard from '../../components/VenueCard.astro';
import { getBuildDatabase } from '../../db/runtime-db';
import type { VenueRow } from '../../db/queries';
import { buildItemListJsonLd } from '../../domain/seo-aggregator';
import { parseVenuePhotos } from '../../domain/venue-photos';

export async function getStaticPaths() {
  const db = getBuildDatabase();
  const provinces = db
    .prepare('SELECT DISTINCT province_slug, province_name FROM municipalities ORDER BY province_name')
    .all() as Array<{ province_slug: string; province_name: string }>;

  const paths = provinces.map((p) => {
    return {
      params: { provincie: p.province_slug },
      props: {
        provinceSlug: p.province_slug,
        provinceName: p.province_name,
      },
    };
  });

  db.close();
  return paths;
}

const { provincie } = Astro.params;
const { provinceName } = Astro.props;

const db = getBuildDatabase();
const venues = db
  .prepare(
    `SELECT
       v.*,
       COALESCE(
         (SELECT b.target_temp_celsius FROM basins b WHERE b.venue_id = v.id AND b.is_default_basin = 1 LIMIT 1),
         (SELECT oc.water_temp_celsius FROM outdoor_conditions oc WHERE oc.venue_id = v.id AND oc.is_current = 1 LIMIT 1)
       ) AS default_temp_celsius,
       (SELECT b.name_nl FROM basins b WHERE b.venue_id = v.id AND b.is_default_basin = 1 LIMIT 1) AS default_basin_name_nl
     FROM venues v
     JOIN municipalities m ON v.municipality_slug = m.slug
     WHERE m.province_slug = ?
     ORDER BY (v.enrichment_tier = 'GOLD_STANDARD') DESC, (v.rating_score IS NOT NULL) DESC, v.rating_score DESC`
  )
  .all(provincie!) as VenueRow[];

const cities = db
  .prepare(
    `SELECT m.slug, m.name, COUNT(v.id) as venue_count
     FROM municipalities m
     JOIN venues v ON v.municipality_slug = m.slug
     WHERE m.province_slug = ?
     GROUP BY m.slug
     ORDER BY venue_count DESC, m.name ASC`
  )
  .all(provincie!) as Array<{ slug: string; name: string; venue_count: number }>;

db.close();

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Nederland',
      item: 'https://zwemkaart.nl/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: provinceName,
      item: `https://zwemkaart.nl/provincies/${provincie}`,
    },
  ],
};

const outdoorCount = venues.filter((v) => v.primary_water_treatment === 'NATURAL_UNTREATED').length;
const indoorCount = venues.length - outdoorCount;
const leadPhoto = venues[0] ? parseVenuePhotos(venues[0])[0] : undefined;
const provinceItemListJsonLd = buildItemListJsonLd({
  name: `Zwembaden & Zwemwater in ${provinceName}`,
  url: `/provincies/${provincie}`,
  items: venues.slice(0, 40).map((v) => ({
    name: v.name,
    url: `/zwembad/${v.municipality_slug}/${v.slug}`,
    image: parseVenuePhotos(v)[0]?.url,
  })),
});
---
<BaseLayout
  title={`Zwembaden in ${provinceName} (${venues.length} locaties) | Zwemkaart.nl`}
  description={`Overzicht van alle ${venues.length} zwembaden, subtropische paradijzen en open water zwemlocaties in ${provinceName}. Vergelijk entreeprijzen, banenzwemmen en zwemles.`}
  canonicalPath={`/provincies/${provincie}`}
  ogImage={leadPhoto?.url}
  ogImageAlt={leadPhoto?.alt_nl}
  jsonLd={[breadcrumbJsonLd, provinceItemListJsonLd]}
>
  <Header />

  <main class="max-w-7xl mx-auto px-4 md:px-8 py-8 flex-1 w-full">
    {/* Breadcrumbs */}
    <nav class="text-xs text-text-muted mb-4 flex items-center gap-2">
      <a href="/" class="hover:underline">Nederland</a>
      <span>›</span>
      <span class="text-text-charcoal font-semibold">{provinceName}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-text-charcoal mb-2">
        Zwembaden &amp; Zwemwater in {provinceName}
      </h1>
      <p class="text-sm text-text-muted max-w-3xl">
        In provincie {provinceName} vind je <strong>{venues.length} zwemlocaties</strong>, waaronder {indoorCount} overdekte zwembaden en {outdoorCount} officiële buitenwater- en recreatielocaties. Vergelijk hieronder actuele entreeprijzen, watertemperaturen en banenzwemmen tijden.
      </p>
    </div>

    {/* Municipalities in this province */}
    {cities.length > 0 && (
      <section class="mb-10 p-6 rounded-2xl bg-surface-subtle border border-border-hairline">
        <h2 class="text-sm font-bold text-text-charcoal mb-3 uppercase tracking-wider">
          Gemeenten in {provinceName} ({cities.length})
        </h2>
        <div class="flex flex-wrap gap-2">
          {cities.map((city) => (
            <a
              href={`/steden/${city.slug}`}
              class="px-3 py-1.5 rounded-full bg-surface-pure border border-border-hairline hover:border-primary text-xs font-semibold text-text-charcoal hover:text-primary transition-all flex items-center gap-1.5 shadow-2xs"
            >
              <span>{city.name}</span>
              <span class="text-text-muted text-[10px] bg-surface-subtle px-1.5 py-0.5 rounded-full">
                {city.venue_count}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Interactive Filter Pills for Province */}
    <section>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5 pb-4 border-b border-border-hairline">
        <h2 class="text-xl font-bold text-text-charcoal">
          Alle zwemlocaties in {provinceName} ({venues.length})
        </h2>
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar">
          <button
            type="button"
            data-filter="ALL"
            class="prov-filter-pill px-3.5 py-1.5 rounded-full text-xs font-bold bg-text-charcoal text-surface-pure border border-text-charcoal cursor-pointer transition-all"
          >
            Alle ({venues.length})
          </button>
          <button
            type="button"
            data-filter="BINNEN"
            class="prov-filter-pill px-3.5 py-1.5 rounded-full text-xs font-semibold bg-surface-subtle text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all"
          >
            Binnenbaden ({indoorCount})
          </button>
          <button
            type="button"
            data-filter="BUITEN"
            class="prov-filter-pill px-3.5 py-1.5 rounded-full text-xs font-semibold bg-surface-subtle text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all"
          >
            Natuurwater ({outdoorCount})
          </button>
          <button
            type="button"
            data-filter="SALT_ELECTROLYSIS"
            class="prov-filter-pill px-3.5 py-1.5 rounded-full text-xs font-semibold bg-surface-pure text-text-charcoal border border-border-hairline hover:border-text-charcoal cursor-pointer transition-all"
          >
            💧 Zoutelektrolyse
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        {venues.map((venue) => (
          <VenueCard venue={venue} />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.prov-filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.venue-card-item');
  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const mode = pill.dataset.filter || 'ALL';
      pills.forEach((p) => {
        const active = p === pill;
        p.classList.toggle('bg-text-charcoal', active);
        p.classList.toggle('text-surface-pure', active);
        p.classList.toggle('bg-surface-subtle', !active);
        p.classList.toggle('text-text-charcoal', !active);
      });
      cards.forEach((card) => {
        const cat = card.dataset.filterCategory;
        const treat = card.dataset.waterTreatment;
        let show = true;
        if (mode === 'BINNEN') show = cat === 'BINNEN' || cat === 'SUBTROPISCH';
        else if (mode === 'BUITEN') show = cat === 'BUITEN';
        else if (mode === 'SALT_ELECTROLYSIS') show = treat === 'SALT_ELECTROLYSIS';
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
