---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchAndFilterIsland from '../components/islands/SearchAndFilterIsland';
import ListingMapIsland from '../components/islands/ListingMapIsland';
import { getBuildDatabase } from '../db/runtime-db';
import { listAllVenues } from '../db/queries';
import { buildItemListJsonLd } from '../domain/seo-aggregator';
import { rankVenuesMultiCityRecommended } from '../domain/multi-city-ranking';
import { parseVenuePhotos } from '../domain/venue-photos';

const db = getBuildDatabase();
const venues = listAllVenues(db);
const provinces = db
  .prepare(
    `SELECT m.province_slug, m.province_name, COUNT(v.id) as venue_count
     FROM municipalities m
     JOIN venues v ON v.municipality_slug = m.slug
     GROUP BY m.province_slug
     ORDER BY m.province_name ASC`
  )
  .all() as Array<{ province_slug: string; province_name: string; venue_count: number }>;

const topCities = db
  .prepare(
    `SELECT m.slug, m.name, COUNT(v.id) as venue_count
     FROM municipalities m
     JOIN venues v ON v.municipality_slug = m.slug
     GROUP BY m.slug
     ORDER BY venue_count DESC, m.name ASC
     LIMIT 24`
  )
  .all() as Array<{ slug: string; name: string; venue_count: number }>;
db.close();

const featuredForSeo = rankVenuesMultiCityRecommended(venues).slice(0, 24);
const homeItemListJsonLd = buildItemListJsonLd({
  name: 'Uitgelichte zwembaden en zwemwaterlocaties in Nederland',
  url: '/',
  items: featuredForSeo.map((v) => ({
    name: v.name,
    url: `/zwembad/${v.municipality_slug}/${v.slug}`,
    image: parseVenuePhotos(v)[0]?.url,
  })),
});

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Zwemkaart.nl',
  url: 'https://zwemkaart.nl/',
  description: 'Vind, vergelijk en boek zwembaden, banenzwemmen en zwemles in Nederland.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://zwemkaart.nl/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout
  title="Zwemkaart.nl - Vind, vergelijk en boek zwembaden & zwemles in Nederland"
  description="Vergelijk binnenbaden, subtropische zwembaden, banenzwemmen tijden, zoutelektrolyse, Zwem-ABC wachttijden en natuurwater in Nederland."
  canonicalPath="/"
  ogImage="/images/venues/official/de-mirandabad.webp"
  ogImageAlt="Overzicht van zwembaden en open water zwemlocaties in Nederland op Zwemkaart.nl"
  jsonLd={[homeJsonLd, homeItemListJsonLd]}
>
  <Header />

  <!-- SECONDARY STICKY 7-CATEGORY BAR (Exact Match to Photo 2) -->
  <section class="sticky top-20 z-30 bg-surface-pure border-b border-border-hairline py-3 shadow-2xs">
    <div class="w-full max-w-[1600px] mx-auto px-4 md:px-8 flex items-center justify-between gap-4">
      <div id="category-scroll-rail" class="flex items-center gap-7 overflow-x-auto no-scrollbar scroll-smooth">
        <!-- Category 1: Alle Baden -->
        <a
          href="/?cat=ALL"
          data-cat="ALL"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-charcoal border-b-2 border-text-charcoal transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 15c1.67-1.33 3.33-2 5-2s3.33.67 5 2c1.67 1.33 3.33 2 5 2s3.33-.67 5-2" />
            <path d="M2 19c1.67-1.33 3.33-2 5-2s3.33.67 5 2c1.67 1.33 3.33 2 5 2s3.33-.67 5-2" />
            <circle cx="8" cy="7" r="2" />
            <path d="M10 11l3-3 4 2" />
          </svg>
          <span class="text-xs font-bold">Alle Baden</span>
        </a>

        <!-- Category 2: Zwemles A/B/C -->
        <a
          href="/steden/amsterdam/zwemles"
          data-cat="ZWEMLES"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-muted hover:text-text-charcoal border-b-2 border-transparent transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          <span class="text-xs font-semibold">Zwemles A/B/C</span>
        </a>

        <!-- Category 3: Banenzwemmen -->
        <a
          href="/steden/amsterdam/banenzwemmen"
          data-cat="BANENZWEMMEN"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-muted hover:text-text-charcoal border-b-2 border-transparent transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="13" r="8" />
            <path d="M12 9v4l2 2" />
            <path d="M10 2h4" />
          </svg>
          <span class="text-xs font-semibold">Banenzwemmen</span>
        </a>

        <!-- Category 4: Subtropisch -->
        <a
          href="/?cat=SUBTROPISCH"
          data-cat="SUBTROPISCH"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-muted hover:text-text-charcoal border-b-2 border-transparent transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 18c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0" />
            <path d="M4 13c1.5-4 6-6 9-3 2 2 1 5-2 5-1.5 0-2.5-1-2-2.5" />
          </svg>
          <span class="text-xs font-semibold">Subtropisch</span>
        </a>

        <!-- Category 5: Buiten & Wetsuit (Herfst Seizoen) -->
        <a
          href="/steden/amsterdam/buitenwater"
          data-cat="BUITEN"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-muted hover:text-text-charcoal border-b-2 border-transparent transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 8c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0" />
            <path d="M2 13c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0" />
            <path d="M2 18c2-1.5 4-1.5 6 0s4 1.5 6 0 4-1.5 6 0" />
          </svg>
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-semibold">Buiten &amp; Wetsuit</span>
            <span class="bg-badge-amber-bg text-accent-seasonal text-[9px] font-bold px-1.5 py-0.5 rounded-full border border-accent-seasonal/30">
              Herfst Seizoen
            </span>
          </div>
        </a>

        <!-- Category 6: Binnenbaden -->
        <a
          href="/?cat=BINNEN"
          data-cat="BINNEN"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-muted hover:text-text-charcoal border-b-2 border-transparent transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 10l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
          <span class="text-xs font-semibold">Binnenbaden</span>
        </a>

        <!-- Category 7: Wellness -->
        <a
          href="/?cat=WELLNESS"
          data-cat="WELLNESS"
          class="cat-tab flex flex-col items-center gap-1.5 pb-2 text-text-muted hover:text-text-charcoal border-b-2 border-transparent transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 6c0-2 2-2 2-4" />
            <path d="M12 6c0-2 2-2 2-4" />
            <path d="M16 6c0-2 2-2 2-4" />
            <rect x="3" y="10" width="18" height="10" rx="3" />
          </svg>
          <span class="text-xs font-semibold">Wellness</span>
        </a>
      </div>

      <!-- Right Action: Filters Modal Pill Trigger -->
      <div class="shrink-0 pl-2">
        <button
          id="open-filters-modal-btn"
          type="button"
          class="flex items-center gap-2 border border-border-strong hover:border-text-charcoal text-text-charcoal text-xs font-bold px-4 py-2.5 rounded-xl transition-colors bg-surface-pure shadow-2xs cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="21" x2="4" y2="14" />
            <line x1="4" y1="10" x2="4" y2="3" />
            <line x1="12" y1="21" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12" y2="3" />
            <line x1="20" y1="21" x2="20" y2="16" />
            <line x1="20" y1="12" x2="20" y2="3" />
            <line x1="1" y1="14" x2="7" y2="14" />
            <line x1="9" y1="8" x2="15" y2="8" />
            <line x1="17" y1="16" x2="23" y2="16" />
          </svg>
          <span>Filters</span>
          <span
            id="active-filters-badge"
            class="w-5 h-5 rounded-full bg-text-charcoal text-surface-pure text-[10px] flex items-center justify-center font-bold"
          >
            0
          </span>
        </button>
      </div>
    </div>
  </section>

  <!-- OFFICIAL ACCREDITATION TRUST BANNER (KNZB, NRZ & Rijkswaterstaat from Photo 2) -->
  <aside class="bg-surface-subtle border-b border-border-hairline py-2">
    <div class="w-full max-w-[1600px] mx-auto px-4 md:px-8 flex flex-wrap items-center justify-between text-xs text-text-muted gap-2">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex items-center gap-1 text-primary-container font-bold">
          <span>✓</span>
          <span>Officieel Erkend Platform</span>
        </span>
        <span class="text-border-strong">•</span>
        <span>Aangesloten bij <strong>KNZB</strong> &amp; <strong>NRZ Zwemveiligheid</strong></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-text-charcoal font-semibold">Zwemwater.nl Live Kwaliteit: 98% Schoon</span>
        <span class="text-border-strong hidden sm:inline">•</span>
        <span class="text-[11px] bg-badge-teal-bg text-primary-container px-2.5 py-0.5 rounded-full font-bold hidden sm:inline">
          Rijkswaterstaat Synchroon
        </span>
      </div>
    </div>
  </aside>

  <!-- MAIN SPLIT VIEW CONTENT (58% LISTINGS GRID / 42% STICKY MAP ON DESKTOP) -->
  <main class="w-full max-w-[1600px] mx-auto px-4 md:px-8 py-6 flex-1">
    <div class="flex flex-col lg:flex-row gap-8 items-start">
      <div class="w-full lg:w-[58%]">
        <SearchAndFilterIsland client:load venues={venues} />
      </div>
      <aside aria-label="Interactieve Kaart" class="w-full lg:w-[42%] lg:sticky lg:top-36">
        <ListingMapIsland client:visible venues={venues} />
      </aside>
    </div>

    <!-- SSR INTERNAL-LINKING & CRAWLER HUB (All 12 Provinces, Top Cities & Category Hubs) -->
    <section aria-label="Zwembaden per stad, provincie en categorie" class="mt-12 pt-10 border-t border-border-hairline space-y-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-xl font-extrabold text-text-charcoal">
            Ontdek zwemlocaties in heel Nederland
          </h2>
          <p class="text-sm text-text-muted mt-1">
            Blader rechtstreeks door alle {venues.length} gecontroleerde binnenbaden, subtropische zwemparadijzen, zwemscholen en officiële Rijkswaterstaat zwemzones.
          </p>
        </div>
        <a
          href="/steden"
          class="text-xs font-extrabold text-primary hover:underline shrink-0"
        >
          Bekijk alle gemeenten en provincies →
        </a>
      </div>

      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-text-muted mb-3">
          Alle 12 Provincies
        </h3>
        <div class="flex flex-wrap gap-2">
          {provinces.map((p) => (
            <a
              href={`/provincies/${p.province_slug}`}
              class="px-3.5 py-1.5 rounded-full bg-surface-subtle border border-border-hairline hover:border-primary text-xs font-semibold text-text-charcoal hover:text-primary transition-colors"
            >
              {p.province_name} ({p.venue_count})
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-text-muted mb-3">
          Populaire Gemeenten &amp; Categorieën
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {topCities.map((c) => (
            <div class="p-3.5 rounded-2xl border border-border-hairline bg-surface-pure space-y-2">
              <div class="flex items-center justify-between gap-2">
                <a
                  href={`/steden/${c.slug}`}
                  class="font-bold text-sm text-text-charcoal hover:text-primary transition-colors truncate"
                >
                  Zwembaden {c.name}
                </a>
                <span class="text-[11px] font-bold text-text-muted shrink-0">
                  {c.venue_count}
                </span>
              </div>
              <div class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-primary font-semibold">
                <a href={`/steden/${c.slug}/banenzwemmen`} class="hover:underline">Banenzwemmen</a>
                <a href={`/steden/${c.slug}/zwemles`} class="hover:underline">Zwemles A/B/C</a>
                <a href={`/steden/${c.slug}/buitenwater`} class="hover:underline">Natuurwater</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  function wireCategoryBar() {
    const tabs = document.querySelectorAll<HTMLAnchorElement>('.cat-tab');
    const filterBtn = document.getElementById('open-filters-modal-btn');
    const badgeEl = document.getElementById('active-filters-badge');

    function setActiveTabUi(activeCat: string) {
      tabs.forEach((tab) => {
        const isCurrent = tab.dataset.cat === activeCat;
        if (isCurrent) {
          tab.classList.remove('text-text-muted', 'border-transparent');
          tab.classList.add('text-text-charcoal', 'border-text-charcoal');
        } else {
          tab.classList.remove('text-text-charcoal', 'border-text-charcoal');
          tab.classList.add('text-text-muted', 'border-transparent');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        // Intercept simple left-clicks for instant 0ms client-side filtering while keeping href crawlable for SEO
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        const cat = tab.dataset.cat || 'ALL';
        setActiveTabUi(cat);
        window.dispatchEvent(new CustomEvent('zwemkaart:set-category', { detail: { category: cat } }));
      });
    });

    if (filterBtn) {
      filterBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('zwemkaart:open-filters'));
      });
    }

    window.addEventListener('zwemkaart:category-changed', (e) => {
      const detail = (e as CustomEvent<{ category: string; activeFilterCount: number }>).detail;
      if (detail?.category) setActiveTabUi(detail.category);
      if (badgeEl && typeof detail?.activeFilterCount === 'number') {
        badgeEl.textContent = String(detail.activeFilterCount);
      }
    });
  }

  wireCategoryBar();
</script>
