---
import WaterTreatmentBadge from './WaterTreatmentBadge.astro';
import { formatEuroCentsNl } from '../domain/seo-aggregator';
import { parseVenuePhotos } from '../domain/venue-photos';
import type { VenueRow } from '../db/queries';

interface Props {
  venue: VenueRow;
}
const { venue } = Astro.props;
const href = `/zwembad/${venue.municipality_slug}/${venue.slug}`;
const photos = parseVenuePhotos(venue);
const isOpenWater = venue.venue_type === 'OPEN_WATER_NATURAL';
const temp = venue.default_temp_celsius;
const filterCategory =
  venue.venue_type === 'SUBTROPICAL_PARADISE'
    ? 'SUBTROPISCH'
    : venue.venue_type === 'OPEN_WATER_NATURAL' || venue.venue_type === 'OUTDOOR_SEASONAL_POOL'
      ? 'BUITEN'
      : 'BINNEN';
---
<article
  class="venue-card-item group flex flex-col transition-all"
  data-venue-type={venue.venue_type}
  data-filter-category={filterCategory}
  data-water-treatment={venue.primary_water_treatment}
  data-nrz={venue.is_nrz_licensed ? '1' : '0'}
  data-rating={venue.rating_score ?? 0}
>
  <div class="relative aspect-[20/19] rounded-2xl overflow-hidden bg-surface-subtle mb-3 shadow-2xs" data-venue-card-carousel>
    <div
      data-venue-card-track
      role="group"
      aria-roledescription="carousel"
      aria-label={`Foto's van ${venue.name}`}
      class="carousel-scroll-track no-scrollbar w-full h-full"
    >
      {photos.map((photo, idx) => (
        <a
          href={href}
          role="group"
          aria-roledescription="slide"
          aria-label={`Foto ${idx + 1} van ${photos.length}`}
          class="carousel-scroll-slide block w-full h-full"
        >
          <img
            src={photo.url}
            alt={photo.alt_nl}
            width="800"
            height="760"
            loading="lazy"
            fetchpriority={idx > 0 ? 'low' : undefined}
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </a>
      ))}
    </div>
    {venue.featured_badge_nl && (
      <span
        class={`absolute top-3 left-3 text-[11px] px-2.5 py-1 rounded-full font-bold shadow-sm pointer-events-none z-10 ${
          venue.venue_type === 'OPEN_WATER_NATURAL'
            ? 'bg-accent-seasonal text-on-primary'
            : venue.featured_badge_nl === 'Populairste Keuze'
              ? 'bg-text-charcoal text-surface-pure'
              : 'bg-primary-container text-on-primary'
        }`}
      >
        {venue.featured_badge_nl}
      </span>
    )}
    {photos.length > 1 && (
      <>
        <button
          type="button"
          data-card-carousel-prev
          aria-label="Vorige foto"
          class="opacity-0 group-hover:opacity-100 focus-visible:opacity-100 absolute left-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-surface-pure/90 text-text-charcoal shadow-md flex items-center justify-center text-xs font-bold hover:scale-105 transition-all cursor-pointer z-10"
        >
          ‹
        </button>
        <button
          type="button"
          data-card-carousel-next
          aria-label="Volgende foto"
          class="opacity-0 group-hover:opacity-100 focus-visible:opacity-100 absolute right-2.5 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-surface-pure/90 text-text-charcoal shadow-md flex items-center justify-center text-xs font-bold hover:scale-105 transition-all cursor-pointer z-10"
        >
          ›
        </button>
      </>
    )}
    <div data-card-carousel-dots class="absolute bottom-2.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 pointer-events-none z-10">
      {photos.slice(0, 5).map((_, idx) => (
        <button
          type="button"
          data-card-carousel-dot={idx}
          aria-label={`Toon foto ${idx + 1}`}
          aria-current={idx === 0 ? 'true' : undefined}
          class={`card-carousel-dot pointer-events-auto rounded-full transition-all cursor-pointer ${
            idx === 0 ? 'w-2 h-2 bg-surface-pure shadow-xs' : 'w-1.5 h-1.5 bg-surface-pure/60'
          }`}
        ></button>
      ))}
    </div>
  </div>

  <div class="flex items-start justify-between gap-2">
    <a href={href} class="text-base font-bold text-text-charcoal group-hover:text-primary transition-colors line-clamp-1">
      {venue.name}
    </a>
    {venue.rating_score && (
      <span class="text-xs font-bold text-text-charcoal shrink-0">
        ★ {venue.rating_score.toFixed(2)} ({venue.rating_count})
      </span>
    )}
  </div>

  <p class="text-xs text-text-muted mt-0.5 line-clamp-1">
    {venue.default_basin_name_nl ?? venue.neighborhood_name ?? venue.municipality_slug}
  </p>

  <div class="mt-2 flex flex-wrap items-center gap-1.5">
    {isOpenWater ? (
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] bg-badge-amber-bg text-accent-seasonal font-bold border border-accent-seasonal/25">
        <span>❄️</span>
        <span>
          {temp ? `Watertemp: ${temp.toFixed(1)}°C • Wetsuit advies` : 'Natuurwater • Rijkswaterstaat'}
        </span>
      </span>
    ) : (
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] bg-badge-teal-bg text-primary-container font-bold">
        <span>🌡️</span>
        <span>Watertemp: {(temp ?? 28.0).toFixed(1)}°C • Binnen open</span>
      </span>
    )}
    <WaterTreatmentBadge treatment={venue.primary_water_treatment} />
  </div>

  <div class="mt-2.5 pt-2.5 border-t border-border-hairline flex items-baseline justify-between">
    <span class="text-sm font-extrabold text-text-charcoal">
      {venue.min_single_price_cents === 0
        ? 'Gratis toegang'
        : venue.min_single_price_cents
          ? `Vanaf ${formatEuroCentsNl(venue.min_single_price_cents)}`
          : isOpenWater
            ? 'Betaald terrein'
            : 'Prijs op aanvraag'}
    </span>
    <a href={href} class="text-xs font-semibold text-primary hover:underline">
      Bekijk rooster &amp; zwemles →
    </a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-venue-card-carousel]').forEach((root) => {
    if (root.dataset.carouselWired === 'true') return;
    root.dataset.carouselWired = 'true';

    const track = root.querySelector<HTMLElement>('[data-venue-card-track]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-card-carousel-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-card-carousel-next]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-card-carousel-dot]'));
    if (!track || dots.length === 0) return;

    function syncDots(activeIdx: number) {
      dots.forEach((dot, idx) => {
        const isActive = idx === activeIdx;
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
        dot.classList.toggle('w-2', isActive);
        dot.classList.toggle('h-2', isActive);
        dot.classList.toggle('bg-surface-pure', isActive);
        dot.classList.toggle('shadow-xs', isActive);
        dot.classList.toggle('w-1.5', !isActive);
        dot.classList.toggle('h-1.5', !isActive);
        dot.classList.toggle('bg-surface-pure/60', !isActive);
      });
    }

    function currentIndex(): number {
      if (!track || track.clientWidth <= 0) return 0;
      return Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
    }

    function goTo(index: number) {
      if (!track || track.clientWidth <= 0) return;
      const wrapped = (index + dots.length) % dots.length;
      track.scrollTo({ left: wrapped * track.clientWidth, behavior: 'smooth' });
      syncDots(wrapped);
    }

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      goTo(currentIndex() - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      goTo(currentIndex() + 1);
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goTo(idx);
      });
    });

    let rafId = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (rafId) return;
        rafId = window.requestAnimationFrame(() => {
          rafId = 0;
          syncDots(currentIndex());
        });
      },
      { passive: true }
    );
  });
</script>
